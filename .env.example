# ==============================================================================
# VARIÁVEIS DO FRONTEND (Públicas — incluídas no bundle Vite)
# NUNCA coloque service_role, secrets de Redis ou chaves de IA com prefixo VITE_
# ==============================================================================
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_CHAVE_ANON_PUBLICA"

# ==============================================================================
# VARIÁVEIS DO SERVIDOR / CLOUDFLARE WORKERS SECRETS (Privadas — apenas backend)
# ==============================================================================
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="SUA_CHAVE_ANON_PUBLICA"
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash Redis REST (Compatível com Node.js e Cloudflare Workers)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Gemini API Key (usada exclusivamente no backend para OCR de etiquetas de pacotes)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_OCR_MODEL="gemini-4-hydrogen"

# Opcional: token read-only para /api/github-versao e URL pública da aplicação
GITHUB_TOKEN=""
APP_URL="MY_APP_URL"
